# See the documentation for more information: https://github.com/Quad4-Software/Quad4-ID

# These variables must be configured for your deployment:
APP_URL=https://id.example.com

# Encryption key (choose one method):
# Method 1: Direct key (simple but less secure)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Method 2: File-based key (recommended)
# Put the base64 key in a file and point to it here.
# ENCRYPTION_KEY_FILE=/path/to/encryption_key

# These variables are optional but recommended to review:
TRUST_PROXY=false
MAXMIND_LICENSE_KEY=

# Scheduled backups (all optional; everything here can also be set in the admin UI):
# BACKUP_ENABLED=false
# BACKUP_DESTINATION=local            # local or s3
# BACKUP_LOCAL_PATH=data/backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_COUNT=14
# BACKUP_ENCRYPTION_KEY=              # passphrase that encrypts archives with AES-256-GCM; _FILE variant supported
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=
# BACKUP_S3_ENDPOINT=                 # custom endpoint for S3-compatible services
# BACKUP_S3_PREFIX=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=        # _FILE variant supported
# BACKUP_S3_FORCE_PATH_STYLE=false
